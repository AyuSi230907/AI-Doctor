# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Which Claude model to use for report analysis
ANTHROPIC_MODEL=claude-sonnet-5

# Flask secret key - change this to a random string in production
SECRET_KEY=change-this-to-a-random-secret-string

# National / local emergency number shown on the Emergency button (India default)
EMERGENCY_NUMBER=112
